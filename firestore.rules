rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // 허용 이메일 목록: accessControl/allowedEmails 문서의 emails 배열 (소문자로 입력)
    // 목록 문서가 없거나 emails가 배열이 아니면 아무도 허용되지 않습니다.
    function isAllowedUser() {
      return isVerifiedEmail()
        && exists(/databases/$(database)/documents/accessControl/allowedEmails)
        && get(/databases/$(database)/documents/accessControl/allowedEmails).data.emails is list
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/accessControl/allowedEmails).data.emails;
    }

    // 목록은 등록된 사용자만 읽을 수 있고, 수정은 Firebase 콘솔에서만 가능
    match /accessControl/{docId} {
      allow read: if isAllowedUser();
      allow write: if false;
    }

    // 기부금영수증: 주민번호 명단(registry)과 설정(settings: 노조 파일 암호·지식출판콘텐츠원 금액)
    match /donationData/registry {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.keys().hasOnly(['people', 'updatedAt', 'updatedBy'])
        && request.resource.data.people is map
        && request.resource.data.people.size() < 5000
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /donationData/settings {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.keys().hasOnly(['unionPassword', 'manualGroup', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /accountingData/{documentId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && request.resource.data.value is string
        && request.resource.data.value.size() < 900000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail is string;
      allow delete: if false;

      // 장부 내역(회계연도별): accountingData/ledger:{연도}/entries/{내역ID}
      match /entries/{entryId} {
        allow read, create, update, delete: if isAllowedUser();
      }

      // 영수증 증빙(회계연도별): accountingData/ledger:{연도}/receipts/{내역ID}
      match /receipts/{entryId} {
        allow read, delete: if isAllowedUser();
        allow create, update: if isAllowedUser()
          && request.resource.data.keys().hasOnly(['name', 'type', 'data', 'size', 'updatedAt', 'updatedBy'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 950000
          && request.resource.data.updatedBy == request.auth.uid;
      }
    }
  }
}
