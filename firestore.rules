rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // 로그인한 Google 계정의 이메일(소문자)이 allowedEmails 컬렉션에 문서 ID로 등록되어 있어야 허용
    function isVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isAllowedUser() {
      return isVerifiedEmail()
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email.lower()));
    }

    // 문서 ID = 이메일(소문자). 본인 이메일 문서만 get 가능, 등록·수정·삭제는 Firebase 콘솔에서만
    match /allowedEmails/{email} {
      allow get: if isVerifiedEmail() && request.auth.token.email.lower() == email;
      allow list, create, update, delete: if false;
    }

    match /accountingData/{documentId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && request.resource.data.value is string
        && request.resource.data.value.size() < 900000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail is string;
      allow delete: if false;
    }
  }
}
